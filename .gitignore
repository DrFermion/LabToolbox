# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build artifacts / 构建产物
build/
dist/
*.spec.bak
installer/*.exe
*.log

# ImageJ + JRE downloaded at build time by scripts/fetch_imagej.py (not committed)
vendor/
# Local verification tools (Inno Setup etc.), not committed
.tools/

# Output
output/
*.png

# Application icons must be committed (exception to the *.png rule above)
!assets/*.png

# IDE
.vscode/
.idea/

# System
Thumbs.db
.DS_Store

# Data (raw data stays in OneDrive; example data excepted)
data/raw/
!data/examples/