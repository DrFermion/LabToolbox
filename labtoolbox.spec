# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller packaging spec for LabToolbox (Windows x64 + macOS Intel/Apple Silicon).

Usage:
    pyinstaller labtoolbox.spec --noconfirm

Prerequisites (run once per platform before building):
    python scripts/fetch_imagej.py      # assembles vendor/imagej (ij.jar + native JRE)

Environment:
    APP_VERSION   optional release version (from git tag); falls back to pyproject.toml.
                  Used for the macOS Info.plist bundle version and the Windows installer.

Everything the app needs at run time is bundled: no ImageJ/Java installation and no
network download is required on the target machine.
"""
import os
import platform
import re
import subprocess
import sys

# Project root (PyInstaller sets SPECFILE to the .spec path)
ROOT = os.path.dirname(os.path.abspath(SPECFILE)) if 'SPECFILE' in globals() else os.getcwd()


def _read_version():
    """Release version: APP_VERSION env (CI tag) -> pyproject.toml -> fallback."""
    version = os.environ.get("APP_VERSION", "").strip()
    if not version:
        try:
            with open(os.path.join(ROOT, "pyproject.toml"), encoding="utf-8") as fh:
                match = re.search(r'(?m)^version\s*=\s*"([^"]+)"', fh.read())
            if match:
                version = match.group(1).strip()
        except OSError:
            version = ""
    if not version:
        version = "0.0.0"
    return version.lstrip("v")


APP_VERSION = _read_version()
# CFBundleShortVersionString must be 1-3 dot-separated integers; keep the numeric prefix.
MACOS_SHORT_VERSION = re.match(r"^[0-9]+(\.[0-9]+){0,2}", APP_VERSION)
MACOS_SHORT_VERSION = MACOS_SHORT_VERSION.group(0) if MACOS_SHORT_VERSION else "0.0.0"
# CFBundleVersion: monotonic build number; numeric-only, so derive from the version.
MACOS_BUILD_VERSION = re.sub(r"[^0-9.]", "", APP_VERSION).strip(".") or "1"

print(f"[labtoolbox.spec] version={APP_VERSION} platform={sys.platform} arch={os.uname().machine if hasattr(os, 'uname') else 'windows'}")

# Bundle icon: drop a replaceable assets/labtoolbox.ico (Windows) / .icns (macOS)
# into the repo; assets are generated by scripts/build_icons.py.
icon_path = None
for cand in [os.path.join(ROOT, "assets", "labtoolbox.ico"),
             os.path.join(ROOT, "assets", "labtoolbox.icns")]:
    if os.path.exists(cand):
        icon_path = cand
if icon_path is None:
    print("[labtoolbox.spec] WARNING: no assets/labtoolbox.ico|.icns found; using default icon")

datas = []

# ---- Bundled ImageJ 1.54 + native Java runtime (assembled by scripts/fetch_imagej.py) ----
# Path contract used by labtoolbox/livedead_cellcounter/cellcounter.py:
#   <bundle>/imagej/ij.jar
#   <bundle>/imagej/jre/bin/java.exe                       (Windows)
#   <bundle>/imagej/jre/Contents/Home/bin/java             (macOS Intel / Apple Silicon)
IMAGEJ_DIR = os.path.join(ROOT, "vendor", "imagej")
if not os.path.isdir(IMAGEJ_DIR):
    # Self-contained builds: the repository's current CI workflow does not run the
    # fetch step, so assemble vendor/imagej here when it is missing.
    if sys.platform.startswith("win"):
        _plat = "windows"
    elif sys.platform == "darwin":
        _plat = "macos-arm64" if platform.machine() == "arm64" else "macos-intel"
    else:
        raise SystemExit("unsupported build platform for bundled ImageJ")
    print(f"[labtoolbox.spec] vendor/imagej missing; fetching platform={_plat}")
    subprocess.check_call([sys.executable, os.path.join(ROOT, "scripts", "fetch_imagej.py"),
                           "--platform", _plat])
if not os.path.isfile(os.path.join(IMAGEJ_DIR, "ij.jar")):
    raise SystemExit("vendor/imagej/ij.jar is missing - re-run 'python scripts/fetch_imagej.py'")
datas.append((IMAGEJ_DIR, "imagej"))

# ---- Read-only ImageJ counting macro (never copied at run time) ----
MACRO = os.path.join(ROOT, "scripts", "imagej", "count_livedead.ijm")
if not os.path.isfile(MACRO):
    raise SystemExit("scripts/imagej/count_livedead.ijm is missing from the repository")
datas.append((MACRO, "scripts/imagej"))

# ---- Example data used by the GUI "open example" buttons / CLI demos ----
datas.append((os.path.join(ROOT, "examples"), "examples"))
datas.append((os.path.join(ROOT, "data", "examples"), "data/examples"))

# ---- Third-party attributions (bundled ImageJ/JRE licenses + overall notices) ----
THIRD_PARTY = os.path.join(ROOT, "THIRD_PARTY_NOTICES.md")
if os.path.isfile(THIRD_PARTY):
    datas.append((THIRD_PARTY, "."))

# ---- igor (Bruker .ibw reader, LGPL-3.0+) must be installed for the build ----
# The PyPI package named "igor" is an empty shell; install the real one with
#   pip install "igor @ git+https://github.com/wking/igor"
try:
    import igor as _igor  # noqa: F401
except ImportError:
    # Self-contained builds: install the real igor package (PyPI "igor" is empty).
    print("[labtoolbox.spec] igor missing; installing from GitHub")
    subprocess.check_call([sys.executable, "-m", "pip", "install",
                           "igor @ git+https://github.com/wking/igor"])
try:
    import importlib.metadata as _md

    _igor_dist = _md.distribution("igor")
    for _entry in _md.files("igor") or []:
        if _entry.name in ("COPYING", "COPYING.LESSER"):
            datas.append((str(_igor_dist.locate_file(_entry)), "third_party"))
except Exception as _exc:  # noqa: BLE001 - license bundling is best effort
    print(f"[labtoolbox.spec] WARNING: could not bundle igor license files: {_exc}")

a = Analysis(
    [os.path.join(ROOT, "labtoolbox", "gui.py")],
    pathex=[ROOT],
    binaries=[],
    datas=datas,
    hiddenimports=[
        "labtoolbox.growth_curve",
        "labtoolbox.lipss_dloa",
        "labtoolbox.xdlvo",
        "labtoolbox.livedead",
        "labtoolbox.livedead_cellcounter",
        "labtoolbox.contact_angle",
        "labtoolbox.contact_schematic",
        "labtoolbox.semtexture",
        "labtoolbox.surfmetrics",
        "labtoolbox.common.io_utils",
        "labtoolbox.common.fitting",
        "labtoolbox.common.stats",
        "labtoolbox.i18n",
        "igor",            # .ibw direct read (wking/igor, GitHub install)
        "igor.binarywave",
        "igor.struct",
        "igor.util",
        "tifffile",        # height-map .tif reading
        "scipy.optimize",
        "scipy.ndimage",
        "scipy.stats",
        "statsmodels.formula.api",
        "statsmodels.api",
    ],
    hookspath=[],
    runtime_hooks=[],
    excludes=["tkinter.test"],   # keep unittest (pyparsing) and pydoc (scipy._lib._docscrape)
    noarchive=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="LabToolbox",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=False,          # GUI application: no console window
    icon=icon_path,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=True,
    upx_exclude=[],
    name="LabToolbox",
)

# macOS: produce a real .app bundle (DMG is built from this in CI)
if sys.platform == "darwin":
    app = BUNDLE(
        coll,
        name="LabToolbox.app",
        icon=icon_path,
        bundle_identifier="uk.ac.dundee.labtoolbox",
        info_plist={
            "CFBundleName": "LabToolbox",
            "CFBundleDisplayName": "LabToolbox",
            "CFBundleShortVersionString": MACOS_SHORT_VERSION,
            "CFBundleVersion": MACOS_BUILD_VERSION,
            "CFBundleGetInfoString": f"LabToolbox {APP_VERSION} (bundled ImageJ 1.54 + Temurin 11 JRE)",
            "NSHighResolutionCapable": True,
            "LSMinimumSystemVersion": "11.0",
            "NSHumanReadableCopyright": "MIT License - Ruinong Pan (DrFermion), University of Dundee",
        },
    )